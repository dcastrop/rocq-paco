ROCQMODULE   := Paco
ROCQTHEORIES := $(sort $(wildcard *.v))
ROCQMAKEFILE := Makefile.rocq

# Rocq >= 9.3 warns unless --rocq-package is given; we keep the classic
# user-contrib install layout (same as Rocq 9.2), so silence that warning
# when the option exists.
ROCQMAKEFLAGS := $(shell rocq makefile --help 2>&1 | grep -q -- --no-rocq-package-warning && echo --no-rocq-package-warning)

# Build artifacts. Removed directly by "clean", never through the generated
# makefile: a Makefile.rocq generated by one Rocq version and run by another
# can delete the .v sources.
ARTIFACTS := *.vo *.vok *.vos *.glob *.v.d .*.aux *.timing *.cmi *.cmx *.cmo *.o

.PHONY: all quick install uninstall clean doc install-doc FORCE

all: $(ROCQMAKEFILE)
	$(MAKE) -f $(ROCQMAKEFILE) all

quick: $(ROCQMAKEFILE)
	$(MAKE) -f $(ROCQMAKEFILE) quick

install: $(ROCQMAKEFILE)
	$(MAKE) -f $(ROCQMAKEFILE) install

uninstall: $(ROCQMAKEFILE)
	$(MAKE) -f $(ROCQMAKEFILE) uninstall

# Stamp of the Rocq in PATH. When it changes, drop stale objects (they would
# fail with "bad version number") and regenerate the makefile.
.rocq-version: FORCE
	@v="$$(rocq --version 2>/dev/null | head -n1)"; \
	if [ "$$v" != "$$(cat $@ 2>/dev/null)" ]; then \
	  echo "Rocq changed ($$v): removing stale build artifacts"; \
	  rm -f $(ARTIFACTS) _RocqProject $(ROCQMAKEFILE) $(ROCQMAKEFILE).conf .$(ROCQMAKEFILE).d; \
	  echo "$$v" > $@; \
	fi

$(ROCQMAKEFILE): Makefile .rocq-version $(ROCQTHEORIES)
	(echo "-Q . $(ROCQMODULE)"; \
	 echo $(ROCQTHEORIES)) > _RocqProject
	rocq makefile $(ROCQMAKEFLAGS) -f _RocqProject -o $(ROCQMAKEFILE)

doc: $(ROCQMAKEFILE)
	$(MAKE) -f $(ROCQMAKEFILE) html
	cp index.html main.css html

install-doc: doc
	$(MAKE) -f $(ROCQMAKEFILE) install-doc

clean:
	rm -f $(ARTIFACTS) _RocqProject $(ROCQMAKEFILE) $(ROCQMAKEFILE).conf .$(ROCQMAKEFILE).d .rocq-version
	rm -rf html
